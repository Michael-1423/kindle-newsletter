# --- Ollama ---
OLLAMA_HOST=http://localhost:11435
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_EMBED_MODEL=qwen3-embedding:latest
# Reasoning models (gemma4, qwen3, deepseek-r1) must have thinking disabled or they
# spend the whole token budget thinking and return nothing. Set true only for models
# where you want the reasoning trace and have raised the token budget.
OLLAMA_THINK=false
# Ollama defaults to 4096, which truncates long brief bundles before the model can
# finish a section. 8192 costs ~1 GB of VRAM and is the right default for 24 GB Macs.
OLLAMA_NUM_CTX=8192
# Extra models for `--compare` (comma separated). The writer model above is always
# included automatically.
OLLAMA_COMPARE_MODELS=llama3.1:8b

# --- Kindle delivery ---
# Your Send-to-Kindle address (find it in Amazon > Manage Your Content and Devices > Devices)
KINDLE_EMAIL=your-kindle@kindle.com

# --- SMTP (Gmail example; use an App Password, not your login password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SENDER_NAME=The Daily Signal
